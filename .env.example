# Copy to .env and replace the media paths with existing absolute host paths.
# This file contains placeholders only; keep .env out of version control.
GPU_FORGE_IMAGE=weasts/media-forge:2.1.0
GPU_FORGE_BIND_IP=127.0.0.1
GPU_FORGE_PORT=8090
GPU_FORGE_CONFIG_PATH=./config
GPU_FORGE_LOG_LEVEL=INFO
UPSCALE_FORGE_LOG_LEVEL=INFO
UPSCALE_FORGE_CONFIG_PATH=../upscaler/config
MEDIA_MOVIES_PATH=/absolute/path/to/movies
MEDIA_TV_PATH=/absolute/path/to/tv
TZ=Etc/UTC
